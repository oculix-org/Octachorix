<?xml version="1.0" encoding="UTF-8"?>
<!--
    Octachorix - Deterministic, session-oriented, geometry-first
    Tesseract runtime for the JVM.

    Copyright (C) 2026 Julien Mer
    Licensed under the GNU General Public License v3.0 - see LICENSE.

    IMPORTANT: No dependency on tess4j or lept4j. Ever.
    This is enforced at build time and reviewed at every dependency update.
    See ARCHITECTURE.txt section 2.4 for the rationale.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.oculix-org</groupId>
    <artifactId>octachorix</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Octachorix</name>
    <description>
        Deterministic, session-oriented, geometry-first Tesseract runtime
        for the JVM. Loads native libraries by strict absolute path only,
        exposes a session-based API with modern type system, returns text
        and geometry from a single recognition pass. Independent
        implementation against the upstream Tesseract C API.
    </description>
    <url>https://github.com/oculix-org/Octachorix</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>julienmerconsulting</id>
            <name>Julien Mer</name>
            <url>https://github.com/julienmerconsulting</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/oculix-org/Octachorix.git</connection>
        <developerConnection>scm:git:git@github.com:oculix-org/Octachorix.git</developerConnection>
        <url>https://github.com/oculix-org/Octachorix</url>
    </scm>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jna.version>5.14.0</jna.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- JNA: the only runtime dependency. -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>${jna.version}</version>
        </dependency>

        <!-- Tests only. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
